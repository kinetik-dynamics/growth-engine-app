{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Growth Engine",
  "version": "0.4.1",
  "identifier": "com.polashmahmud.growth-engine-app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Growth Engine",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/kinetik-dynamics/growth-engine-app/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBDRUFDQTNDNzBEN0JDRjYKUldUMnZOZHdQTXJxREpCamJSb3gxbXdoRmV0QXV3dkxoQ3VrK1gyL3drcDRYbS9NZ0ZYd0E3VDAK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
